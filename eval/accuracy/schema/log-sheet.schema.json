{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://curator-app.local/schemas/log-sheet.schema.json",
  "title": "ExpectedLogSheet",
  "description": "Golden expected rows for a PH event / sign-in log sheet. Each array item is one person (one table row).",
  "type": "object",
  "additionalProperties": false,
  "required": ["entries"],
  "properties": {
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "contact.schema.json" }
    },
    "_meta": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string" },
        "difficulty": { "enum": ["easy", "medium", "hard"] },
        "handwriting": { "type": "boolean" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string" }
      }
    }
  }
}
