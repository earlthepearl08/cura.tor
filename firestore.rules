rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Users ---
    // Entitlements (tier, contactLimit, lifetimeLimit, stripe, event packs, org,
    // trial expiry) are server-only (Admin SDK: Stripe webhook, redeem/bootstrap
    // APIs, grant-trial, provision-enterprise). Clients must not self-upgrade.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      // New accounts always start free with free-tier caps.
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.uid == userId
                    && request.resource.data.tier == 'free'
                    && request.resource.data.contactLimit == 25
                    && request.resource.data.scanUsage.count == 0
                    && request.resource.data.scanUsage.lifetimeCount == 0
                    && request.resource.data.scanUsage.lifetimeLimit == null
                    && request.resource.data.get('eventPackCredits', 0) == 0
                    && request.resource.data.get('eventPackPurchased', 0) == 0
                    && request.resource.data.get('organizationId', null) == null;

      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.uid == resource.data.uid
                    // Tier / paid entitlements immutable from client
                    && request.resource.data.tier == resource.data.tier
                    && request.resource.data.contactLimit == resource.data.contactLimit
                    && request.resource.data.scanUsage.lifetimeLimit
                         == resource.data.scanUsage.lifetimeLimit
                    // Scan counters may only increase (monthly reset + quota via Admin SDK)
                    && request.resource.data.scanUsage.lifetimeCount
                         >= resource.data.scanUsage.lifetimeCount
                    && request.resource.data.scanUsage.count
                         >= resource.data.scanUsage.count
                    // Billing / packs / org / trial fields immutable from client
                    && request.resource.data.get('stripe', null)
                         == resource.data.get('stripe', null)
                    && request.resource.data.get('eventPackCredits', 0)
                         == resource.data.get('eventPackCredits', 0)
                    && request.resource.data.get('eventPackPurchased', 0)
                         == resource.data.get('eventPackPurchased', 0)
                    && request.resource.data.get('expiresAt', null)
                         == resource.data.get('expiresAt', null)
                    && request.resource.data.get('trialSourceTier', null)
                         == resource.data.get('trialSourceTier', null)
                    && request.resource.data.get('organizationId', null)
                         == resource.data.get('organizationId', null)
                    && request.resource.data.get('orgRole', null)
                         == resource.data.get('orgRole', null)
                    && request.resource.data.get('accessCode', null)
                         == resource.data.get('accessCode', null);

      allow delete: if false;
    }

    // --- Access Codes ---
    match /accessCodes/{codeId} {
      // Any authenticated user can read codes (needed for redemption lookup UX;
      // redemption writes go through Admin SDK — api/account redeem-access-code).
      allow read: if request.auth != null;

      // No client writes — redemption is server-side only.
      allow create, update, delete: if false;
    }

    // --- Organizations (Enterprise) ---
    match /organizations/{orgId} {
      function isMember() {
        return request.auth != null
               && exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid));
      }

      function isOrgAdmin() {
        return isMember()
               && get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.role == 'admin';
      }

      allow read: if isMember();
      allow write: if false;

      match /members/{uid} {
        allow read: if isMember();
        allow write: if false;
      }

      // Contacts — claim rules; org admins may override claims.
      match /contacts/{contactId} {
        allow read: if isMember();
        allow create: if isMember();
        allow delete: if isMember();
        allow update: if isMember()
                      && (
                        request.resource.data.get('claimedBy', null) == resource.data.get('claimedBy', null)
                        || (resource.data.get('claimedBy', null) == null
                            && request.resource.data.claimedBy == request.auth.uid)
                        || (resource.data.get('claimedBy', null) == request.auth.uid
                            && request.resource.data.get('claimedBy', null) == null)
                        || isOrgAdmin()
                      );
      }

      match /folders/{folderId} {
        allow read, write: if isMember();
      }

      match /batches/{batchId} {
        allow read, write: if isMember();
      }

      match /corrections/{correctionId} {
        allow read, write: if isMember();
      }

      match /invites/{code} {
        allow read: if isMember();
        allow write: if false;
      }
    }

    // --- Event workspaces (lightweight trade-show packs) ---
    match /eventWorkspaces/{eventId} {
      function isEventMember() {
        return request.auth != null
               && exists(/databases/$(database)/documents/eventWorkspaces/$(eventId)/members/$(request.auth.uid));
      }

      function isEventHost() {
        return isEventMember()
               && get(/databases/$(database)/documents/eventWorkspaces/$(eventId)/members/$(request.auth.uid)).data.role == 'host';
      }

      allow read: if isEventMember();
      allow write: if false;

      match /members/{uid} {
        allow read: if isEventMember();
        allow write: if false;
      }

      match /contacts/{contactId} {
        allow read: if isEventMember();
        allow create: if isEventMember()
                      && get(/databases/$(database)/documents/eventWorkspaces/$(eventId)).data.status == 'active'
                      && get(/databases/$(database)/documents/eventWorkspaces/$(eventId)).data.expiresAt > request.time.toMillis();
        allow delete: if isEventMember()
                      && get(/databases/$(database)/documents/eventWorkspaces/$(eventId)).data.status == 'active'
                      && get(/databases/$(database)/documents/eventWorkspaces/$(eventId)).data.expiresAt > request.time.toMillis();
        allow update: if isEventMember()
                      && get(/databases/$(database)/documents/eventWorkspaces/$(eventId)).data.status == 'active'
                      && get(/databases/$(database)/documents/eventWorkspaces/$(eventId)).data.expiresAt > request.time.toMillis()
                      && (
                        request.resource.data.get('claimedBy', null) == resource.data.get('claimedBy', null)
                        || (resource.data.get('claimedBy', null) == null
                            && request.resource.data.claimedBy == request.auth.uid)
                        || (resource.data.get('claimedBy', null) == request.auth.uid
                            && request.resource.data.get('claimedBy', null) == null)
                        || isEventHost()
                      );
      }

      match /folders/{folderId} {
        allow read: if isEventMember();
        allow write: if isEventMember()
                     && get(/databases/$(database)/documents/eventWorkspaces/$(eventId)).data.status == 'active'
                     && get(/databases/$(database)/documents/eventWorkspaces/$(eventId)).data.expiresAt > request.time.toMillis();
      }

      match /batches/{batchId} {
        allow read: if isEventMember();
        allow write: if isEventMember()
                     && get(/databases/$(database)/documents/eventWorkspaces/$(eventId)).data.status == 'active'
                     && get(/databases/$(database)/documents/eventWorkspaces/$(eventId)).data.expiresAt > request.time.toMillis();
      }
    }

    // --- Enterprise Requests ---
    match /enterpriseRequests/{requestId} {
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.keys().hasOnly([
                      'uid', 'email', 'displayName', 'orgName',
                      'teamSize', 'contactEmail', 'notes',
                      'status', 'createdAt', 'type'
                    ])
                    && request.resource.data.orgName is string
                    && request.resource.data.orgName.size() > 0
                    && request.resource.data.orgName.size() <= 200
                    && request.resource.data.contactEmail is string
                    && request.resource.data.contactEmail.size() <= 200
                    && request.resource.data.email is string
                    && request.resource.data.email.size() <= 200
                    && request.resource.data.displayName is string
                    && request.resource.data.displayName.size() <= 200
                    && request.resource.data.notes is string
                    && request.resource.data.notes.size() <= 2000
                    && request.resource.data.teamSize is int
                    && request.resource.data.teamSize >= 1
                    && request.resource.data.teamSize <= 100000;

      allow read, update, delete: if false;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
